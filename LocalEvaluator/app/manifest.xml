<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
           xmlns:ov="http://schemas.microsoft.com/office/taskpaneappversionoverrides"
           xsi:type="TaskPaneApp">
  <Id>7c1f0f5e-3b7a-4d0e-9c55-2a6b8e41d9a3</Id>
  <!-- Keep this version fixed: workbooks that carry the pane refer to it, and a change orphans them. -->
  <Version>1.0.0.0</Version>
  <ProviderName>Local Evaluator</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Local Evaluator"/>
  <Description DefaultValue="Drafts bid evaluations with a model running on this computer. Works offline."/>
  <IconUrl DefaultValue="https://localhost:47821/assets/icon-32.png"/>
  <HighResolutionIconUrl DefaultValue="https://localhost:47821/assets/icon-64.png"/>
  <SupportUrl DefaultValue="https://localhost:47821/help.html"/>
  <AppDomains>
    <AppDomain>https://localhost:47821</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Workbook"/>
  </Hosts>
  <DefaultSettings>
    <SourceLocation DefaultValue="https://localhost:47821/taskpane.html"/>
  </DefaultSettings>
  <Permissions>ReadWriteDocument</Permissions>
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Hosts>
      <Host xsi:type="Workbook">
        <DesktopFormFactor>
          <FunctionFile resid="Commands.Url"/>
          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <OfficeTab id="TabHome">
              <Group id="LocalEvaluator.Group">
                <Label resid="Group.Label"/>
                <Icon>
                  <bt:Image size="16" resid="Icon.16"/>
                  <bt:Image size="32" resid="Icon.32"/>
                  <bt:Image size="80" resid="Icon.80"/>
                </Icon>
                <Control xsi:type="Button" id="LocalEvaluator.Open">
                  <Label resid="Button.Label"/>
                  <Supertip>
                    <Title resid="Button.Label"/>
                    <Description resid="Button.Tip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16"/>
                    <bt:Image size="32" resid="Icon.32"/>
                    <bt:Image size="80" resid="Icon.80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <!-- this exact id lets a workbook reopen the pane by itself (Office.AutoShowTaskpaneWithDocument) -->
                    <TaskpaneId>Office.AutoShowTaskpaneWithDocument</TaskpaneId>
                    <SourceLocation resid="Pane.Url"/>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16" DefaultValue="https://localhost:47821/assets/icon-16.png"/>
        <bt:Image id="Icon.32" DefaultValue="https://localhost:47821/assets/icon-32.png"/>
        <bt:Image id="Icon.80" DefaultValue="https://localhost:47821/assets/icon-80.png"/>
      </bt:Images>
      <bt:Urls>
        <bt:Url id="Commands.Url" DefaultValue="https://localhost:47821/commands.html"/>
        <bt:Url id="Pane.Url" DefaultValue="https://localhost:47821/taskpane.html"/>
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="Group.Label" DefaultValue="Local Evaluator"/>
        <bt:String id="Button.Label" DefaultValue="Local Evaluator"/>
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="Button.Tip" DefaultValue="Open the offline bid evaluator. Runs on this computer only."/>
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
